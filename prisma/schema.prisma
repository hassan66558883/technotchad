// TechnoTchad Digital Platform — data model
// Runs on PostgreSQL (Prisma Postgres). Enums are intentionally modeled as
// strings rather than native Postgres enums to keep migrations simple.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Users & roles ------------------------------------------------------
// role: SUPER_ADMIN | ADMIN | TRAINER | ACCOUNTANT | EDITOR | STUDENT
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STUDENT")
  createdAt DateTime @default(now())

  student Student?
  logs    ActivityLog[]
}

model Student {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  phone     String
  email     String   @unique
  photoUrl  String?
  createdAt DateTime @default(now())

  registrations Registration[]
  certificates  Certificate[]
}

model Instructor {
  id       String  @id @default(cuid())
  name     String
  bio      String?
  photoUrl String?
  email    String?
  phone    String?

  courses CourseSession[]
}

// --- Training: courses, sessions, workshops ------------------------------
model Course {
  slug        String   @id
  category    String
  title       String
  description String
  imageUrl    String?
  price       String
  durationLabel String

  sessions CourseSession[]
}

// status: UPCOMING | ONGOING | COMPLETED | CANCELLED
model CourseSession {
  id           String   @id @default(cuid())
  courseSlug   String
  course       Course   @relation(fields: [courseSlug], references: [slug])
  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  startDate    DateTime
  endDate      DateTime?
  schedule     String
  seats        Int
  status       String   @default("UPCOMING")

  registrations Registration[]
  attendance    Attendance[]
}

// status: UPCOMING | COMPLETED | CANCELLED
model Workshop {
  slug          String   @id
  title         String
  description   String
  durationLabel String
  schedule      String
  date          DateTime
  seats         Int
  status        String   @default("UPCOMING")

  registrations Registration[]
}

// --- Registrations, attendance, payments, certificates -------------------
// status: PENDING | CONFIRMED | CANCELLED
model Registration {
  id              String  @id @default(cuid())
  studentId       String
  student         Student @relation(fields: [studentId], references: [id])
  courseSessionId String?
  courseSession   CourseSession? @relation(fields: [courseSessionId], references: [id])
  workshopSlug    String?
  workshop        Workshop? @relation(fields: [workshopSlug], references: [slug])
  status          String  @default("PENDING")
  registeredAt    DateTime @default(now())

  attendance  Attendance[]
  payments    Payment[]
  certificate Certificate?
}

model Attendance {
  id              String   @id @default(cuid())
  registrationId  String
  registration    Registration @relation(fields: [registrationId], references: [id])
  courseSessionId String
  courseSession   CourseSession @relation(fields: [courseSessionId], references: [id])
  date            DateTime
  present         Boolean  @default(false)
}

// status: PENDING | PAID | REFUNDED
model Payment {
  id             String   @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])
  amount         Int
  method         String
  status         String   @default("PENDING")
  paidAt         DateTime?
}

model Certificate {
  id                String   @id @default(cuid())
  registrationId    String   @unique
  registration      Registration @relation(fields: [registrationId], references: [id])
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  qrCodeUrl         String?
}

// --- Public content: services, projects, articles, gallery, testimonials -
model Service {
  slug        String @id
  icon        String
  title       String
  description String
  order       Int    @default(0)
}

model Project {
  slug        String   @id
  category    String
  title       String
  client      String
  location    String
  problem     String
  solution    String
  results     String
  technologies String
  coverImage  String?
  order       Int      @default(0)

  images ProjectImage[]
}

model ProjectImage {
  id          String  @id @default(cuid())
  projectSlug String
  project     Project @relation(fields: [projectSlug], references: [slug])
  url         String
  caption     String?
}

// status: DRAFT | PUBLISHED
model Article {
  slug        String   @id
  category    String
  title       String
  excerpt     String
  content     String
  coverImage  String?
  status      String   @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}

model GalleryImage {
  id       String  @id @default(cuid())
  url      String
  caption  String?
  category String?
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String?
  rating      Int      @default(5)
  text        String
  approved    Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}

// topics is a comma-separated list of tags (e.g. "CCNA, CCNP, MCSA")
model Filiere {
  slug   String @id
  title  String
  icon   String
  topics String
  order  Int    @default(0)
}

model TeamMember {
  id       String  @id @default(cuid())
  name     String
  role     String
  initials String
  photoUrl String?
  order    Int     @default(0)
}

model Partner {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?
  order   Int     @default(0)
}

// type: VALUE (Nos valeurs, /a-propos) | WHY_US (Pourquoi choisir TechnoTchad, homepage)
model CompanyValue {
  id          String @id @default(cuid())
  type        String @default("VALUE")
  title       String
  description String
  order       Int    @default(0)
}

model Stat {
  id    String @id @default(cuid())
  label String
  value String
  order Int    @default(0)
}

// --- Commercial: quote requests, settings, media, activity log -----------
// status: NEW | CONTACTED | CLOSED
model QuoteRequest {
  id          String   @id @default(cuid())
  name        String
  company     String?
  phone       String
  email       String
  serviceType String
  budget      String?
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Media {
  id         String   @id @default(cuid())
  url        String
  filename   String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  createdAt  DateTime @default(now())
}
